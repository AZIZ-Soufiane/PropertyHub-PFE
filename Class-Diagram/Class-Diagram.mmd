classDiagram

%% ==================================================
%% USER MANAGEMENT
%% ==================================================

class User {
    +String userId
    +String email
    +String password
    +login()
    +logout()
    +receivePushNotification()
}

class Role {
    +Long id
    +String name
    +String guard_name
    +DateTime created_at
    +DateTime updated_at
}

class Permission {
    +Long id
    +String name
    +String guard_name
    +DateTime created_at
    +DateTime updated_at
}

%% ==================================================
%% PROPERTY DOMAIN
%% ==================================================

class Property {
    +String propertyId
    +Double price
    +String location
    +Long statusId
    +getDetails()
}

class PropertyStatus {
    +Long id
    +String name
}

class Gallery {
    +List~String~ imageUrls
    +addMedia()
    +removeMedia()
}

%% ==================================================
%% INTERACTION SYSTEM
%% ==================================================

class Appointment {
    +DateTime dateTime
    +String status
    +confirm()
    +cancel()
}

class Calendar {
    +List~Appointment~ events
    +sync()
}

class Message {
    +String messageId
    +String content
    +DateTime timestamp
    +send()
}

class Report {
    +String reportId
    +String dataSummary
    +exportPDF()
}

%% ==================================================
%% RELATIONSHIPS
%% ==================================================

Agent "1" --> "*" Property : manages
Property "1" *-- "1" Gallery : contains
Buyer "*" --> "*" Property : favorites
Property "*" --> "1" PropertyStatus : has

Buyer "1" --> "*" Appointment : requests
Agent "1" --> "*" Appointment : conducts
Agent "1" --> "1" Calendar : owns
Calendar "1" --> "*" Appointment : stores

Buyer "1" --> "*" Message : sends
Agent "1" --> "*" Message : sends

Admin "1" --> "*" Report : views

%% ==================================================
%% AUTHORIZATION (SPATIE RBAC)
%% ==================================================

User "*" --> "*" Role : has
Role "*" --> "*" Permission : contains
User "*" --> "*" Permission : has direct

%% ==================================================
%% NOTES ON ROLES
%% ==================================================
%% Roles are stored in database:
%% - Visitor: read-only property access
%% - Buyer: search, favorite, request appointments
%% - Agent: manage listings, view clients, schedule
%% - Admin: manage roles, generate reports
%% ==================================================