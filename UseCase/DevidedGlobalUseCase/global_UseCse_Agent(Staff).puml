@startuml
left to right direction
skinparam packageStyle rectangle

actor "Agent" as Agent

rectangle "Agent Workspace" {

    usecase "Login / Authentication" as Login
    usecase "Send / Receive Messages" as Messages
    usecase "Confirm Appointment" as Confirm
    usecase "Reject Appointment" as Reject
}

Messages ..> Login : <<include>>
Confirm ..> Login : <<include>>
Reject ..> Login : <<include>>

Agent -- Messages
Agent -- Confirm
Agent -- Reject

@enduml