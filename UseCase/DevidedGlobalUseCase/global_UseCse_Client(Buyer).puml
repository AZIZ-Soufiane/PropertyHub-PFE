@startuml
left to right direction
skinparam shadowing false

actor "Visitor" as Visitor
actor "Buyer" as Buyer
actor "Mobile Application" as MobileApp <<System>>

rectangle "Buyer Space" {

    usecase "Login / Authentication" as Login
    usecase "Search & Filter Properties" as Search
    usecase "Compare Properties" as Compare
    usecase "Manage Favorites" as Favorites
    usecase "Schedule Appointment" as Appointment
    usecase "In-App Messaging" as Messaging
    usecase "View Properties via API" as APIView

    Favorites ..> Login : <<include>>
    Appointment ..> Login : <<include>>
    Messaging ..> Login : <<include>>

    APIView ..> Search : <<include>>
}

Visitor -- Search
Visitor -- Compare

Buyer -- Search
Buyer -- Favorites
Buyer -- Appointment
Buyer -- Messaging

MobileApp -- APIView : "Consumes API"

@enduml