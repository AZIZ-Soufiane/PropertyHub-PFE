@startuml
left to right direction
skinparam packageStyle rectangle

actor "Visitor" as Visitor
actor "Buyer" as Buyer
actor "Mobile Application" as MobileApp <<System>>

rectangle "Client (Buyer) Space" {

    rectangle "Sprint 1: Public Access (No Auth)" {
        usecase "Search & Filter Properties" as Search
        usecase "View Property Details" as Details
        usecase "Compare Properties" as Compare
        usecase "Contact Agent Form" as ContactAgent
        usecase "View Properties via API" as APIView
    }

    rectangle "Sprint 2: Authenticated Features" {
        usecase "Login / Authentication" as Login
        usecase "Add to Favorites" as Favorites
        usecase "Schedule Appointment" as Appointment
    }
}

Visitor -- Search
Visitor -- Details
Visitor -- Compare
Visitor -- ContactAgent

Buyer -- Login
Buyer -- Search
Buyer -- Favorites
Buyer -- Appointment

MobileApp -- APIView
MobileApp -- Search

Favorites ..> Login : <<include>>
Appointment ..> Login : <<include>>
APIView ..> Search : <<include>>

@enduml