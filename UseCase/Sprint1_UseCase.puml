@startuml
left to right direction
skinparam shadowing false

actor "Staff (Admin/Agent)" as Staff
actor "Visitor" as Vis

rectangle "Sprint 1: Foundations" {
    (Login / Logout) as UC_Auth
    (Create Property Listing) as UC_Create
    (Edit/Delete Property) as UC_Edit
    (Upload Property Photos) as UC_Photos
    (Browse Property List) as UC_Browse
    (View Property Details) as UC_Details
}

Staff -- UC_Auth
Staff -- UC_Create
Staff -- UC_Edit
Staff -- UC_Photos

Vis -- UC_Browse
Vis -- UC_Details
@enduml