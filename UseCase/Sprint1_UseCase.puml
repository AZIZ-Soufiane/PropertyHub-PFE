@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Visitor" as Visitor
actor "Mobile Application" as MobileApp <<System>>

rectangle "Sprint 1: Public Property Platform" {

  package "Public Property Access" {
      usecase "Search & Filter Properties" as Search
      usecase "View Property Details" as Details
      usecase "Compare Properties" as Compare
      usecase "Contact Agent Form" as ContactAgent
  }

  package "Public Pages" {
      usecase "View About Page" as AboutPage
      usecase "View Agency Info" as AgencyInfo
  }

  package "Mobile API (Public)" {
      usecase "View Properties via API" as APIView
      usecase "Search Properties via API" as APISearch
      usecase "View Property Details via API" as APIDetails
  }

}

Visitor -- Search
Visitor -- Details
Visitor -- Compare
Visitor -- ContactAgent
Visitor -- AboutPage
Visitor -- AgencyInfo

MobileApp -- APIView
MobileApp -- APISearch
MobileApp -- APIDetails

APIView ..> Search : <<include>>
APISearch ..> Search : <<include>>
APIDetails ..> Details : <<include>>

@enduml