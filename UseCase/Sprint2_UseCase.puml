@startuml
left to right direction
skinparam shadowing false

actor "Buyer" as Client
actor "Agent" as Agent

rectangle "Sprint 2: Interaction Tools" {
    (Login / Authentication) as UC_Auth
    (Book Viewing Appointment) as UC_Book
    (Confirm/Reject Appointment) as UC_Confirm
    (Side-by-Side Comparison) as UC_Compare
    (Add to Favorites) as UC_Fav
    (Send/Receive Messages) as UC_Msg
    (Advanced Filtering) as UC_Filter
}

' Buyer Actions
Client -- UC_Auth
Client -- UC_Book
Client -- UC_Compare
Client -- UC_Fav
Client -- UC_Msg
Client -- UC_Filter

' Agent Actions
Agent -- UC_Auth
Agent -- UC_Confirm
Agent -- UC_Msg

' Security Requirements
UC_Book    ..> UC_Auth : <<include>>
UC_Fav     ..> UC_Auth : <<include>>
UC_Msg     ..> UC_Auth : <<include>>
UC_Confirm ..> UC_Auth : <<include>>

@enduml