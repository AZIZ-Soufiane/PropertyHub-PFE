@startuml
left to right direction
skinparam packageStyle rectangle

actor "Agent" as agent
actor "Admin" as admin

admin -up-|> agent

rectangle "Real Estate Platform - Sprint 2 (Admin Scope)" {

    rectangle "Authentication & Security" {
        usecase "Login / Authentication" as UC_Auth
    }

    rectangle "Administration" {
        usecase "View Analytics & Reports" as UC_Analytics
        usecase "Manage Users & Roles" as UC_ManageUsers
    }

    rectangle "Appointment Management (Agent)" {
        usecase "Confirm Appointment" as UC_Confirm
        usecase "Reject Appointment" as UC_Reject
    }

    rectangle "Communication" {
        usecase "Send / Receive Messages" as UC_Messages
    }
}

admin -- UC_Analytics
admin -- UC_ManageUsers

agent -- UC_Messages
agent -- UC_Confirm
agent -- UC_Reject

UC_Messages ..> UC_Auth : <<include>>
UC_Confirm ..> UC_Auth : <<include>>
UC_Reject ..> UC_Auth : <<include>>
UC_Analytics ..> UC_Auth : <<include>>
UC_ManageUsers ..> UC_Auth : <<include>>

@enduml