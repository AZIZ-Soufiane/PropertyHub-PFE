@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Visitor"          as Vis
actor "Buyer"            as Client
actor "Agent"            as Agent
actor "Admin"            as Admin
actor "Mobile User"      as Mob

rectangle "PropertyHub System" {

    (Login / Authentication)        as UC0
    (Search & Filter Properties)    as UC1
    (Compare Properties)            as UC2
    (Manage Favorites)              as UC3
    (Schedule Appointment)          as UC4
    (In-App Messaging)              as UC5
    (Manage Property Listings)      as UC6
    (Manage Images/Gallery)         as UC7
    (Manage Shared Calendar)        as UC8
    (View Client History)           as UC9
    (Manage Users & Roles)          as UC10
    (View Analytics & Reports)      as UC11
    (Receive Push Notifications)    as UC12
}

' Basic Access
Vis    -- UC1
Vis    -- UC2

' Secured Buyer Actions
Client -- UC0
Client -- UC1
Client -- UC3
Client -- UC4
Client -- UC5

' Secured Agent Actions
Agent  -- UC0
Agent  -- UC5
Agent  -- UC6
Agent  -- UC7
Agent  -- UC8
Agent  -- UC9

' Secured Admin Actions
Admin  -- UC0
Admin  -- UC10
Admin  -- UC11

' Mobile Specific
Mob    -- UC12
Client <|-- Mob
Agent  <|-- Mob

' Includes (Security Requirement)
UC3  ..> UC0 : <<include>>
UC4  ..> UC0 : <<include>>
UC5  ..> UC0 : <<include>>
UC6  ..> UC0 : <<include>>
UC7  ..> UC0 : <<include>>
UC8  ..> UC0 : <<include>>
UC9  ..> UC0 : <<include>>
UC10 ..> UC0 : <<include>>
UC11 ..> UC0 : <<include>>
UC12 ..> UC0 : <<include>>

' Admin inherits Agent permissions
Admin -right-> Agent : <<extend>>


@enduml