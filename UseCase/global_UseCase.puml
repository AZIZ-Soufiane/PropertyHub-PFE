@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Visitor" as Visitor
actor "Buyer" as Buyer
actor "Agent" as Agent
actor "Admin" as Admin
actor "Mobile Application" as MobileApp <<System>>
actor "AI Service" as AI <<System>>

Admin -up-|> Agent

rectangle "PropertyHub System - All Sprints" {

  rectangle "Sprint 1: Public Property Platform" {
      package "Public Property Access" {
          (Search & Filter Properties) as Search
          (View Property Details) as Details
          (Compare Properties) as Compare
          (Contact Agent Form) as ContactAgent
          (View About Page) as AboutPage
          (View Agency Info) as AgencyInfo
      }
      package "Mobile API (Public)" {
          (View Properties via API) as APIView
      }
  }

  rectangle "Sprint 2: Agent & Admin" {
      package "Authentication & Security" {
          (Login / Authentication) as Login
      }
      package "Agent Workspace" {
          (Send / Receive Messages) as Messages
          (Confirm Appointment) as Confirm
          (Reject Appointment) as Reject
      }
      package "Administration" {
          (View Analytics & Reports) as Analytics
          (Manage Users & Roles) as ManageUsers
      }
      package "Buyer Services" {
          (Add to Favorites) as Favorites
          (Schedule Appointment) as Appointment
      }
  }

  rectangle "Sprint 3: AI-Powered Smart Comparison" {
      package "Smart Property Intelligence" {
          (AI Analyze Property Features) as AI_AnalyzeFeatures
          (Smart Property Recommendations) as AI_Recommend
          (Price Valuation Estimate) as AI_PriceValuation
          (Similar Properties Suggestion) as AI_SimilarProps
          (Trigger: User Views Property) as TriggerView
      }
  }

}

Visitor --> Search
Visitor --> Details
Visitor --> Compare
Visitor --> ContactAgent
Visitor --> AboutPage
Visitor --> AgencyInfo

Buyer --> Login
Buyer --> Search
Buyer --> Favorites
Buyer --> Appointment
Buyer --> AI_Recommend
Buyer --> AI_PriceValuation
Buyer --> AI_SimilarProps

Agent --> Login
Agent --> Messages
Agent --> Confirm
Agent --> Reject

Admin --> Login
Admin --> Analytics
Admin --> ManageUsers

MobileApp --> APIView
MobileApp --> Search

AI --> AI_AnalyzeFeatures
AI --> AI_Recommend
AI --> AI_PriceValuation
AI --> AI_SimilarProps
AI --> TriggerView

Favorites ..> Login : <<include>>
Appointment ..> Login : <<include>>
Messages ..> Login : <<include>>
Confirm ..> Login : <<include>>
Reject ..> Login : <<include>>
Analytics ..> Login : <<include>>
ManageUsers ..> Login : <<include>>

APIView ..> Search : <<include>>

TriggerView ..> AI_AnalyzeFeatures : <<trigger>>
AI_AnalyzeFeatures ..> AI_Recommend : <<include>>
AI_AnalyzeFeatures ..> AI_SimilarProps : <<include>>

@enduml